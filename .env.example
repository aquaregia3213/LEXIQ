# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads/contracts

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_ai_db

# Neo4j Knowledge Graph Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# AI Provider Configuration
# Options: 'gemini' (production) or 'deterministic' (offline dev/test)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001


# Agent Orchestration Configuration
# Options: 'native' (default) or 'langflow'
AGENT_ORCHESTRATOR=native
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_FLOW_ID=your_langflow_flow_id_here
LANGFLOW_API_KEY=your_langflow_api_key_here
LANGFLOW_TIMEOUT_SECONDS=30.0
LANGFLOW_FALLBACK_TO_NATIVE=true
LEXIQ_INTERNAL_API_KEY=lexiq_internal_secret_token

# eCourts Integration Configuration
# Options: 'portal_assisted' (official portal link & lawful intake), 'mock' (test data), 'authorized_api' (institutional API Setu/NIC)
ECOURTS_INTEGRATION_MODE=portal_assisted
ECOURTS_PORTAL_URL=https://services.ecourts.gov.in/ecourtindia_v6/
ECOURTS_API_URL=
ECOURTS_CLIENT_ID=
ECOURTS_CLIENT_SECRET=
ECOURTS_TIMEOUT_SECONDS=15.0

# Legacy / Alternative AI Provider Keys
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_embedding_api_key_here

